<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Dark mode theme with Material 3 and balanced color scheme -->
    <style name="Theme.Reverser" parent="Theme.Material3.DayNight">
        <!-- Primary brand color (Lighter Blue for dark mode) -->
        <item name="colorPrimary">@color/primary_light_blue_dark</item>
        <item name="colorPrimaryVariant">@color/primary_blue_dark</item>
        <item name="colorOnPrimary">@color/black</item>
        <!-- Secondary brand color (Purple to match primary palette) -->
        <item name="colorSecondary">@color/primary_light_blue_dark</item>
        <item name="colorSecondaryVariant">@color/primary_blue_dark</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Tertiary brand color (Warning Orange) -->
        <item name="colorTertiary">@color/warning_orange_light_dark</item>
        <item name="colorOnTertiary">@color/black</item>
        <!-- Error color (Security Red) -->
        <item name="colorError">@color/security_red_light_dark</item>
        <item name="colorOnError">@color/black</item>
        <!-- Status bar color (very dark for dark mode) -->
        <item name="android:statusBarColor" tools:targetApi="l">@color/status_bar_dark</item>
        <!-- Customize your theme here -->
    </style>
    
    <style name="Theme.Reverser.PopupOverlay" parent="ThemeOverlay.Material3.Dark" />
</resources>