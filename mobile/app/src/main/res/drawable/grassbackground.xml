<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- White background -->
    <item>
        <color android:color="@color/background_primary" />
    </item>
    
    <!-- Grass tile repeating -->
    <item>
        <bitmap
            android:src="@drawable/grass_tile_v2"
            android:tileMode="repeat"
            android:gravity="fill" />
    </item>
</layer-list>
