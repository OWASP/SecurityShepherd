<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_scoreboard_row"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/entry_place"
        android:layout_width="28dp"
        android:layout_height="wrap_content"
        android:text="1"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@android:color/black" />

    <TextView
        android:id="@+id/entry_username"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:text="username"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:ellipsize="end"
        android:maxLines="1" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginEnd="10dp">

        <TextView
            android:id="@+id/entry_medal_gold"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="3dp"
            android:background="@drawable/bg_medal_gold"
            android:gravity="center"
            android:text="0"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@android:color/black" />

        <TextView
            android:id="@+id/entry_medal_silver"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="3dp"
            android:background="@drawable/bg_medal_silver"
            android:gravity="center"
            android:text="0"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@android:color/black" />

        <TextView
            android:id="@+id/entry_medal_bronze"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:background="@drawable/bg_medal_bronze"
            android:gravity="center"
            android:text="0"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@android:color/black" />

    </LinearLayout>

    <TextView
        android:id="@+id/entry_score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="@android:color/white" />

</LinearLayout>
